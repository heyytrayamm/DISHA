PROJECT_NAME="AI-Powered Label Compliance Checking System"
VERSION="2026.1.0"
SECRET_KEY="super-secret-sih2026-compliance-key-change-in-production"

# Database Configuration (PostgreSQL / SQLite)
DATABASE_URL="sqlite:///./label_compliance.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/sih_compliance_db"

# AWS S3 Configuration (Optional - Fallback to local storage if empty)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
S3_BUCKET_NAME=""

# Ox Alpha AI Integration (Statutory Declaration Interpretation Layer)
OX_ALPHA_API_KEY=""
OX_ALPHA_BASE_URL="https://oxalpha.run/api/v1"
OX_ALPHA_MODEL="ox-alpha"

# Authentication
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Email / SMTP (Optional - Verification emails logged to console if not configured)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@disha.gov.in"
SMTP_FROM_NAME="DISHA - Digital Inspection & Standards Hub"
SMTP_USE_TLS=true
EMAIL_VERIFICATION_REQUIRED=false

# Frontend URL (for email verification and password reset links)
FRONTEND_URL="http://localhost:5173"
